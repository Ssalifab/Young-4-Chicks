extends layout 
block content
  header 
    title Sales Dashboard 
  .container
    .row
      .col-8
        .card
          .card-header.d-flex.justify-content-between.align-items-center
            h5.mb-0 Sales Dashboard
            div
              button.btn.btn-primary.me-2(data-bs-toggle='modal' data-bs-target='#newRequestModal')
                | New Request
          .card-body
            table#salesTable.table.table-striped.table-h6-font
              thead
                tr
                  th Customer Name
                  th Chick Type
                  th Breed
                  th Farmer Type
                  th Quantity
              tbody
      // New Request Modal
      #newRequestModal.modal.fade(tabindex='-1' aria-labelledby='exampleModalLabel' aria-hidden='true')
        .modal-dialog
          .modal-content
            .modal-header
              h1#newRequestModal.modal-title.fs-5 New Chick Request 
              button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
            .modal-body
              form#salesForm(action = '/addSales' method ='post')
                .form-group
                  label(for='farmerName') Customer Name
                  input#farmerNameS.form-control(name = 'farmerName' type='text')
                .form-group
                  label(for='chickTypeS') Chick Type
                  select#chickTypeS.form-control(name='chickTypeS')
                    option(value='') Select chick type
                    option(value='layer') Layer
                    option(value='broiler') Broiler
                .form-group
                  label(for='breed') Breed
                  select#breedS.form-control(name='breed')
                    option(value='') Select breed
                    option(value='local') Local
                    option(value='exotic') Exotic
                .form-group
                  label(for='farmerTypeS') Farmer Type
                  select#farmerTypeS.form-control(name='farmerTypeS')
                    option(value='') Select farmer type
                    option(value='starter') Starter(Max 100 chicks)
                    option(value='returning') Returning (Max 500 chicks)
                .form-group
                  label(for='quantityS') Quantity
                  input#quantityS.form-control(name = 'quantityS' type='number')
                button.btn.btn-primary.me-2 Submit Request
                p#errorMsgSales.text-danger
      script(src='/js/salesScript.js')
      script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
      script(src='/css/bootstrap/js/bootstrap.bundle.js')
