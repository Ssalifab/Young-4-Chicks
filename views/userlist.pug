extends layout 
block content 
    head
        meta(charset='UTF-8')
        meta(name='viewport' content='width=device-width, initial-scale=1.0')
        title Users List
    .container
        .row
            .col-lg-12.col-md-12.col-sm-12.dashboard-box
                .card
                    .card-header.d-flex.justify-content-between.align-items-center
                        h5.mb-1
                            | Staff List  
                            i.fa.fa-circle-user
                        .card-body
                            table.table.table-striped.table-h6-font.justify-content-between
                                thead
                                    tr
                                        th(scope='col') First name
                                        th(scope='col') Last name
                                        th(scope='col') Age
                                        th(scope='col') Gender
                                        //- th(scope='col') NiN 
                                        th(scope='col') Email 
                                        th(scope='col') Phone 
                                        //- th(scope='col') Address 
                                        //- th(scope='col') Recommender name 
                                        //- th(scope='col') Recommender email 
                                        //- th(scope='col') Recommender phone 
                                        th(scope='col') Role 
                                tbody
                                    if users.length 
                                        each user in users
                                            if user.role=="brooderManager"||user.role=="salesRep"
                                                tr 
                                                    td #{user.firstName}
                                                    td #{user.lastName}
                                                    td #{user.age}
                                                    td #{user.gender}
                                                    //- td #{user.nin}
                                                    td #{user.email}
                                                    td #{user.phone}
                                                    //- td #{user.address}
                                                    //- td #{user.recommenderName}
                                                    //- td #{user.recommenderEmail}
                                                    //- td #{user.recommenderPhone}
                                                    td #{user.role}
        
            .col-lg-12.col-md-12.col-sm-12.dashboard-box
                .card
                    .card-header.d-flex.justify-content-between.align-items-center            
                        h5.mb-1
                            | Farmer's List  
                            i.fa.fa-circle-user
                        .card-body
                            table.table.table-striped.table-h6-font.justify-content-between
                                thead
                                    tr
                                        th(scope='col') First name
                                        th(scope='col') Last name
                                        th(scope='col') Age
                                        th(scope='col') Gender
                                        //- th(scope='col') NiN 
                                        th(scope='col') Email 
                                        th(scope='col') Phone 
                                        //- th(scope='col') Address 
                                        //- th(scope='col') Recommender name 
                                        //- th(scope='col') Recommender email 
                                        //- th(scope='col') Recommender phone 
                                        th(scope='col') Role 
                                tbody
                                    if users.length 
                                        each user in users
                                            if user.role=="farmer"
                                                tr 
                                                    td #{user.firstName}
                                                    td #{user.lastName}
                                                    td #{user.age}
                                                    td #{user.gender}
                                                    //- td #{user.nin}
                                                    td #{user.email}
                                                    td #{user.phone}
                                                    //- td #{user.address}
                                                    //- td #{user.recommenderName}
                                                    //- td #{user.recommenderEmail}
                                                    //- td #{user.recommenderPhone}
                                                    td #{user.role}