extends layout

block content
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Young4ChickS Farmer Dashboard
    // Bootstrap CSS
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='/css/bootstrap/css/bootstrap.css')
    // Font Awesome for icons
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/fontawesome-free-6.7.2-web/css/all.min.css')
    // Custom CSS
    link(rel='stylesheet' href='/css/styles.css')
    // Modal-specific CSS
    style.
      .restriction-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
        z-index: 1050;
      }
      .restriction-modal-content {
        background-color: white;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 500px;
      }
      .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
      }
      .close:hover {
        color: #000;
      }
  body.chicks
    .container
      .row
        .col-lg-8.col-md-12.col-sm-12.dashboard-top-container.mt-2.d-flex.justify-content-left.back_color
          img.chicken-pic-dashboard(src='/img/chicken.jpg' alt='Logo')
          h3.mt-2 Young4ChickS
        .col-lg-4.col-md-12.col-sm-12.dashboard-top-container.mt-2.d-flex.justify-content-between.back_color
          p.mt-3.Welcome-h5
            i
              b Welcome
          p.mt-3
            i.fa-regular.fa-user
            |  #{farmerName}
          p.mt-3.Welcome-h5
            b Farmer
          a(href='/logout')
            button.btn.btn-light.mt-2
              | Logout 
              i.fa-solid.fa-right-from-bracket
    .container
      .row
        .col-12.dashboard-button.mt-2.d-flex.justify-content-between
          h2.mt-2 Welcome,
          h2.mt-2.ml-3.Welcome-h5User #{farmerName}
          .col
          button#newRequestButton.btn.btn-success.dashboard-button.mt-1(data-bs-toggle='modal' data-bs-target='#myRequestsModal')
            i.fa-solid.fa-phone
            |  New Request
        .col-12.d-flex.justify-content-between
          p Manage your chick requests and track your farming journey
    .container.dashboard-box
      .row.dashboard-box
        .col-lg-12.col-md-12.col-sm-12.dashboard-box.back_color
          .card
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-1
                | Available Stock 
                i.fa-solid.fa-boxes-stacked
            .card-body
              .container
                .row
                  .col-lg-6.col-md-12.col-sm-12.back_color
                    .card-header.d-flex.justify-content-between.align-items-center
                      h5 Layers
                      h5.Welcome-h5 #{layers}
                    .card-header.d-flex.justify-content-between.align-items-center
                      h5 Local 
                      h5 #{local}
                    hr.line.mt-1
                    .d-flex.justify-content-between.align-items-center.mt-1
                      h6 UGx 1,650 per chick
                  .col-lg-6.col-md-12.col-sm-12.back_color
                    .card-header.d-flex.justify-content-between.align-items-center
                      h5 Broilers
                      h5.Welcome-h5 #{broilers}
                    .card-header.d-flex.justify-content-between.align-items-center
                      h5 Exotic 
                      h5 #{exotic}
                    hr.line.mt-1
                    .d-flex.justify-content-between.align-items-center.mt-1
                      h6 UGx 1,650 per chick
    .container.dashboard-box
      .row.dashboard-box
        .col-lg-12.col-md-12.col-sm-12.dashboard-box.back_color
          .card
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-1
                | My Requests 
                i.fa-solid.fa-phone
            .card-body
              table#myRequestsTable.table.table-striped.table-h6-font.justify-content-between
                thead
                  tr
                    th Farmer Type
                    th Type
                    th Breed
                    th Quantity
                    th Unit Price
                    th Total Price
                    th Request Date
                tbody
                  if requests.length
                    each request in requests 
                      tr
                        td #{request.farmerType}
                        td #{request.chickType}
                        td #{request.breed}
                        td #{request.quantity}
                        td #{request.unitPrice}
                        td #{request.totalPrice}
                        td #{moment(request.dateUpdated).format("DD-MM-YYYY")}

    // New Request Modal
    #myRequestsModal.modal.fade(tabindex='-1' aria-labelledby='myRequestsModalLabel' aria-hidden='true')
      .modal-dialog
        .modal-content
          .modal-header
            h1#myRequestsModalLabel.modal-title.fs-5 New Chick Request
            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
          .modal-body
            form#newRequestForm(action='/farmer' method='POST')
              .form-group
                label(for='farmerType') Farmer Type
                .form-check 
                  input.form-check-input#starter(type='radio' name='farmerType' value='starter' checked=isStarter)
                  label.form-check-label(for='starter') Starter Farmer (Max 100 Chicks)
                .form-check 
                  input.form-check-input#returning(type='radio' name='farmerType' value='returning' checked=!isStarter)
                  label.form-check-label(for='returning') Returning Farmer (Max 500 Chicks)
              .form-group
                label(for='chickType') Type
                select#chickType.form-control(name='chickType')
                  option(value='') --Select chick type--
                  option(value='layer') Layer
                  option(value='broiler') Broiler
              .form-group
                label(for='breed') Breed
                select#breed.form-control(name='breed')
                  option(value='') --Select breed--
                  option(value='local') Local
                  option(value='exotic') Exotic
              .form-group
                label(for='quantity') Quantity
                input#quantity.form-control(name='quantity' type='number' placeholder='--Enter number of chicks--' min='1' max=isStarter ? '100' : '500')
                small.form-text-muted Maximum: #{isStarter ? '100' : '500'} Chicks 
              .form-group
                label(for='unitPrice') Unit Price (UGx)
                input#unitPrice.form-control(name='unitPrice' type='number' value='1650' readonly)
              .form-group
                label(for='totalPrice') Total Price (UGx)
                input#totalPrice.form-control(name='totalPrice' type='number' readonly)  
              .form-group
                label(for='dateUpdated') Date Updated
                input#dateUpdated.form-control(name='dateUpdated' type='date')
              a(href='/farmer')
                button.btn.btn-light(type='button' style='width: 200px;')
                  i.fa-solid.fa-ban
                  |  Cancel
              button.btn.btn-success.me-2(type='submit')
                i.fa-solid.fa-plus
                |  Submit Request
              p#errorMsg.text-danger

    // Date Restriction Modal
    #dateRestrictionModal.restriction-modal
      .restriction-modal-content
        span.close &times;
        p#restrictionMessage.text-danger Farmer cannot make any request until...

    // Bootstrap JS Bundle with Popper
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
    script(src='/css/bootstrap/js/bootstrap.bundle.js')
    script(src='/js/include.js')
    // Custom JavaScript
    script.
      // Total Price Calculation
      document.getElementById('quantity').addEventListener('input', function() {
        const quantity = parseInt(this.value) || 0;
        const unitPrice = 1650;
        const totalPriceInput = document.getElementById('totalPrice');
        if (totalPriceInput) {
          totalPriceInput.value = quantity * unitPrice;
        }
      });

      // Function to disable New Request Button based on dateUpdated
      function disableRequestButton(dateUpdated) {
        const button = document.getElementById('newRequestButton');
        const modal = document.getElementById('dateRestrictionModal');
        const modalMessage = document.getElementById('restrictionMessage');
        const closeModal = document.getElementsByClassName('close')[0];

        // Parse the dateUpdated string to a Date object
        const updatedDate = new Date(dateUpdated);
        const currentDate = new Date();

        // Calculate the date 4 months from updatedDate
        const fourMonthsLater = new Date(updatedDate);
        fourMonthsLater.setMonth(updatedDate.getMonth() + 4);

        // Check if current date is less than 4 months from updatedDate
        if (currentDate < fourMonthsLater) {
          button.disabled = true;
          button.classList.add('btn-disabled'); // Optional: Add Bootstrap disabled styling
          button.removeAttribute('data-bs-toggle');
          button.removeAttribute('data-bs-target');

          // Format the date for display in modal
          const formattedDate = fourMonthsLater.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });

          // Update modal message
          modalMessage.textContent = `Farmer cannot make any request until ${formattedDate}.`;

          // Show modal when button is clicked
          button.addEventListener('click', () => {
            modal.style.display = 'block';
          });

          // Close modal when close button is clicked
          closeModal.addEventListener('click', () => {
            modal.style.display = 'none';
          });

          // Close modal when clicking outside of modal
          window.addEventListener('click', (event) => {
            if (event.target === modal) {
              modal.style.display = 'none';
            }
          });
        } else {
          button.disabled = false;
          button.classList.remove('btn-disabled');
          button.setAttribute('data-bs-toggle', 'modal');
          button.setAttribute('data-bs-target', '#myRequestsModal');
        }
      }

      // Get the latest request date from MongoDB data
      const requests = !{JSON.stringify(requests)};
      if (requests.length > 0) {
        const latestRequest = requests.reduce((latest, request) => {
          const currentDate = new Date(request.dateUpdated);
          return !latest || currentDate > new Date(latest.dateUpdated) ? request : latest;
        }, null);
        if (latestRequest) {
          disableRequestButton(latestRequest.dateUpdated);
        }
      }
