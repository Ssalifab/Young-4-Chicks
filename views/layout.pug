doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Young4Chicks 
  // Bootstrap CSS
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
  link(rel='stylesheet' href='/css/bootstrap/css/bootstrap.css')
  link(rel='stylesheet' href='/css/fontawesome-free-6.7.2-web/css/all.min.css')
  link(rel='stylesheet', href='/css/styles.css')
nav.navbar.navbar-expand.bg-body-tertiary
  .container-fluid
    a.navbar-brand.nav-bar-layout(href='/') Young4ChickS
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNavAltMarkup' aria-controls='navbarNavAltMarkup' aria-expanded='false' aria-label='Toggle navigation')
      span.navbar-toggler-icon
    #navbarNavAltMarkup.collapse.navbar-collapse
      .navbar-nav
        a.nav-link.active.nav-bar-layout(aria-current='page' href='/') Home
        a.nav-link.nav-bar-layout(href='/login') Login
        
        //- Dashboards dropdown
        .nav-item.dropdown
          a.nav-link.nav-bar-layout.dropdown-toggle.success-on-active(
            href='#' 
            role='button' 
            data-bs-toggle='dropdown' 
            aria-expanded='false'
          ) Dashboards
          ul.dropdown-menu
            li
              a.dropdown-item(href='/stock') Manager Dashboard
            li
              a.dropdown-item(href='/sales') Sales Dashboard
            li
              a.dropdown-item(href='/farmer') Farmer Dashboard
        
        a.nav-link.nav-bar-layout(href='/') Contact Us
block content 