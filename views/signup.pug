extends layout 
block content 
  body.background-chicks
    .container.mt-2
      .signup-container
        .row.justify-content-center
          .col-lg-12.col-md-10
            .card
              .card-header
                .container
                  .row
                    .col-2
                      img.chicken-pic.mt-1(src='/img/chicken.jpg' alt='Logo')
                    .col-10
                      h2.mt-2 Join Young4ChickS
                      p Please register to get started:
              .card-body
                // Tab Navigation
                ul#formTabs.nav.nav-tabs.mb-4(role='tablist')
                  li.nav-item(role='presentation')
                    button#personal-tab.nav-link.active.signup-nav-tabs(data-bs-toggle='tab' data-bs-target='#personal' type='button' role='tab') Personal Info
                  li.nav-item(role='presentation')
                    button#contact-tab.nav-link.signup-nav-tabs(data-bs-toggle='tab' data-bs-target='#contact' type='button' role='tab') Contact Details
                  li.nav-item(role='presentation')
                    button#recommender-tab.nav-link.signup-nav-tabs(data-bs-toggle='tab' data-bs-target='#recommender' type='button' role='tab')
                      | Recommender
                      | Details
                  li.nav-item(role='presentation')
                    button#account-tab.nav-link.signup-nav-tabs(data-bs-toggle='tab' data-bs-target='#account' type='button' role='tab') Account Settings
                // Form with Tab Content
                form(ation='/signup' method='POST')
                  #formTabsContent.tab-content
                    // Personal Info Tab
                    #personal.tab-pane.fade.show.active(role='tabpanel' aria-labelledby='personal-tab')
                      .mb-3
                        label.form-label(for='firstName') First Name
                        input#firstName.form-control(name='firstName' placeholder='--Enter your first name--' type='text')
                      .mb-3
                        label.form-label(for='lastName') Last Name
                        input#lastName.form-control(name='lastName' placeholder='--Enter your last name--' type='text')
                      .mb-3
                        label.form-label(for='age') Age (18-30)
                        input#age.form-control(name='age' placeholder='--Enter your age--' type='number')
                      .mb-3
                        label.form-label(for='gender') Gender
                        select#gender.form-control(name='gender')
                          option(value='') --Select gender--
                          option(value='male') Male
                          option(value='female') Female
                          option(value='notStated') Prefer not to say
                          option(value='Other') Other
                      .mb-3
                        label.form-label(for='nin') National ID Number
                        input#nin.form-control(name='nin' placeholder='--Enter your national ID number--' type='text')
                      .mb-3
                        label.form-label(for='farmerId')
                          | Upload a copy of your ID
                          i (pdf/jpeg)
                        input#farmerId.form-control(name='farmerId' type='file')
                      .d-flex.justify-content-between
                        a(href='/signup')
                          button.btn.btn-secondary.prev-tab(type='button' data-prev-tab='personal-tab')
                            i.fa-solid.fa-arrow-left
                            |  Back to
                            |                                                     login
                        button.btn.btn-primary.next-tab(type='button' data-next-tab='contact-tab')
                          | Next 
                          i.fa-solid.fa-arrow-right
                    // Contact Details Tab
                    #contact.tab-pane.fade(role='tabpanel' aria-labelledby='contact-tab')
                      .mb-3
                        label.form-label(for='email') Email Address
                        input#email.form-control(name='email' placeholder='--Enter your email address--' type='email')
                      .mb-3
                        label.form-label(for='phone') Phone Number
                        input#phone.form-control(name='phone' placeholder='--Enter your phone number--' type='tel')
                      .mb-3
                        label.form-label(for='address') Address
                        textarea#address.form-control(name='address' placeholder='--Enter your address--' rows='3' type='text')
                      .d-flex.justify-content-between
                        button.btn.btn-secondary.prev-tab(type='button' data-prev-tab='personal-tab')
                          i.fa-solid.fa-arrow-left
                          |                                                 Previous
                        button.btn.btn-primary.next-tab(type='button' data-next-tab='recommender-tab')
                          | Next 
                          i.fa-solid.fa-arrow-right
                    // Recommender Details Tab
                    #recommender.tab-pane.fade(role='tabpanel' aria-labelledby='recommender-tab')
                      .mb-3
                        label.form-label(for='recommenderName') Recommender Name
                        input.form-control(name='recommenderName' type='text' placeholder="--Enter recommender's name--")
                      .mb-3
                        label.form-label(for='recommenderEmail') Email Address
                        input.form-control(name='recommenderEmail' type='email' placeholder="--Enter recommender's email address--")
                      .mb-3
                        label.form-label(for='recommenderPhone') Phone Number
                        input#phone.form-control(type='tel' name='recommenderPhone' placeholder="--Enter recommender's phone number--")
                      .mb-3
                        label.form-label(for='recommenderAddress') Address
                        textarea#address.form-control(rows='3' placeholder="--Enter recommender's Address--" name='recommenderAddress' type='text')
                      .mb-3
                        label.form-label(for='recommenderId')
                          | Upload a copy of your
                          | Recommender&apos;s ID 
                          i (pdf/jpeg)
                        input#recommenderId.form-control(name='recommenderId' type='file')
                      .d-flex.justify-content-between
                        button.btn.btn-secondary.prev-tab(type='button' data-prev-tab='contact-tab')
                          i.fa-solid.fa-arrow-left
                          |                                                 Previous
                        button.btn.btn-primary.next-tab(type='button' data-next-tab='account-tab')
                          | Next 
                          i.fa-solid.fa-arrow-right
                    // Account Settings Tab
                    #account.tab-pane.fade(role='tabpanel' aria-labelledby='account-tab')
                      .mb-3
                        label.form-label(for='role') Role
                        select#role.form-control(name='role')
                          option(value='') --Select role--
                          option(value='farmer') Farmer
                          option(value='salesRep') Sales Representative
                          option(value='brooderManager') Brooder Manager
                      .mb-3
                        label.form-label(for='password') Create Password
                        input#password.form-control(type='password' name='password' placeholder='--Create a password--')
                      .mb-3
                        label.form-label(for='confirmPassword') Confirm Password
                        input#confirmPassword.form-control(type='password' name='confirmPassword' placeholder='--Confirm your password--')
                      .mb-3.form-check
                        input#terms.form-check-input(type='checkbox' name='terms')
                        label.form-check-label(for='terms')
                          | I agree to the terms and
                          | conditions
                      .d-flex.justify-content-between
                        button.btn.btn-secondary.prev-tab(type='button' data-prev-tab='recommender-tab')
                          i.fa-solid.fa-arrow-left
                          |                                                 Previous
                        button.btn.btn-success(type='submit')
                          i.fa-solid.fa-user
                          |                                                 Create Account
    // Bootstrap JS Bundle with Popper
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
    script(src='/scripts/signupScript.js')
