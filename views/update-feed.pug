extends layout 
block content
    head
        meta(charset='UTF-8')
        meta(name='viewport' content='width=device-width, initial-scale=1.0')
        title Young4ChickS Manager Dashboard
        // Bootstrap CSS
        link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
        link(rel='stylesheet' href='/css/bootstrap/css/bootstrap.css')
        // Font Awesome for icons
        link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
        link(rel='stylesheet' href='/css/fontawesome-free-6.7.2-web/css/all.min.css')
        // Custom CSS
        link(rel='stylesheet' href='/css/styles.css')
    body.chicks    
        .container.mt-5
            .row.justify-content-center
                .col-lg-6.col-md-6.col-sm-12.dashboard-button.mt-3.d-flex.justify-content-between.back_color
                    form#addFeedsForm(method="POST" action=`/updateFeed/${feed._id}`)
                        .form-group.mb-3
                        label.form-label(for='feedName') Feed Name
                        select#feedName.form-select(name='feedName' required)
                            option(value='starter' selected=feed.feedName ==='starter') Starter Feed
                            option(value='grower' selected=feed.feedName ==='grower') Grower Feed
                            option(value='finisher' selected=feed.feedName ==='finisher') Finisher Feed

                        .form-group.mb-3
                        label.form-label(for='feedType') Feed Type
                        select#feedType.form-select(name='feedType' required)
                            option(value='mash' selected=feed.feedType ==='mash') Mash
                            option(value='crumble' selected=feed.feedType ==='crumble') Crumble
                            option(value='pellet' selected=feed.feedType ==='pellet') Pellet

                        .form-group.mb-3
                        label.form-label(for='targetAge') Target Age
                        select#targetAge.form-select(name='targetAge' required)
                            option(value='oneToSeven' selected=feed.targetAge ==='oneToSeven') Day 1-7
                            option(value='eightToFourteen' selected=feed.targetAge ==='eightToFourteen') Day 8-14
                            option(value='fifteenToThirty' selected=feed.targetAge ==='fifteenToThirty') Day 15-30

                        .form-group.mb-3
                        label.form-label(for='brand') Brand / Supplier
                        select#brand.form-select(name='brand' required)
                            option(value='ugaChick' selected=feed.brand ==='ugaChick') UgaChick
                            option(value='nuvita' selected=feed.brand ==='nuvita') Nuvita
                            option(value='farmersChoice' selected=feed.brand ==='farmersChoice') Farmers Choice
                            option(value='kukuFeed' selected=feed.brand ==='kukuFeed') Kuku feed
                        .form-group.mb-3
                        label.form-label(for='stock') Stock (100 kg bags)
                        input#stock.form-control(name='stock' type='number' min='0' step='1' value=feed.stock)

                        .form-group.mb-3
                        label.form-label(for='price') Price per kg
                        input#price.form-control(name='price' type='number' min='0' step='0.01' value=feed.price)

                        .form-group.mb-3
                        label.form-label(for='expiryDate') Expiry Date
                        input#expiryDate.form-control(name='expiryDate' type='date' value=feed.expiryDate)
                        .form-group.mb-3
                        label.form-label(for='dateUpdated') Date Updated
                        input#dateUpdated.form-control(name='dateUpdated' type='date' value=feed.dateUpdated)

                        .d-flex.justify-content-between.mt-4
                        button.btn.btn-light(type='button' href='/feedsList' data-bs-dismiss='modal' style='width: 200px;')
                            i.fas.fa-ban.me-1
                            | Cancel
                        button.btn.btn-success(type='submit')
                            i.fas.fa-plus.me-1
                            | Update

                        p#errorMsg.text-danger.mt-2

            // Scripts
            script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
            script(src='https://kit.fontawesome.com/a076d05399.js' crossorigin='anonymous')
            //- script(src='/js/feeds.js')