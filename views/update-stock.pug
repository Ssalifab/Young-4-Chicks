extends layout 
block content
    head
        meta(charset='UTF-8')
        meta(name='viewport' content='width=device-width, initial-scale=1.0')
        title Young4ChickS Manager Dashboard
        // Bootstrap CSS
        link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
        link(rel='stylesheet' href='/css/bootstrap/css/bootstrap.css')
        // Font Awesome for icons
        link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
        link(rel='stylesheet' href='/css/fontawesome-free-6.7.2-web/css/all.min.css')
        // Custom CSS
        link(rel='stylesheet' href='/css/styles.css')
    body.chicks    
        .container.mt-5
            .row.justify-content-center
                .col-lg-6.col-md-6.col-sm-12.dashboard-button.mt-3.d-flex.justify-content-between.back_color
                    form#addStockForm(action='/updateStock?id='+ stock._id method='POST')
                            .form-group
                                label(for='chickType') Type
                                select#chickType.form-control(name='chickType')
                                    option(value='layer' selected=stock.chickType==='layer') Layer
                                    option(value='broiler' selected=stock.chickType==='broiler') Broiler
                            .form-group
                                label(for='breed') Breed
                                select#breed.form-control(name='breed')
                                    option(value='local' selected=stock.breed==='local') Local
                                    option(value='exotic' selected=stock.breed==='exotic') Exotic
                            .form-group
                                label(for='quantity') Quantity
                                input#quantity.form-control(name='quantity' type='number' value=stock.quantity)
                            .form-group
                                label(for='age') Age (days)
                                input#age.form-control(name='age' type='number' value=stock.age)
                            .form-group
                                label(for='dateUpdated') Date Updated
                                input#dateUpdated.form-control(name='dateUpdated' type='date' value=stock.dateUpdated)
                            a(href='/stockList')
                                button.btn.btn-light(type='button' style='width: 200px;')
                                    i.fa-solid.fa-ban
                                    |                 Cancel
                            button.btn.btn-success.me-2(type='submit')
                                i.fa-solid.fa-plus
                                |  Update Stock
                            p#errorMsg.text-danger                   

    // Bootstrap JS Bundle with Popper
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
    script(src='/css/bootstrap/js/bootstrap.bundle.js')
    script(src='/js/include.js')
    // Custom JavaScript
    //- script(src='/scripts/managerDashboard.js')
