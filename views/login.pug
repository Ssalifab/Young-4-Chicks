extends layout 
block content 
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Young4ChickS Login Form
    // Bootstrap CSS
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
    link(rel="stylesheet" href="/css/bootstrap/css/bootstrap.css")
    // Font Awesome
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet" href="/css/fontawesome-free-6.7.2-web/css/all.min.css")
    // Custom CSS
    link(rel="stylesheet" href="/css/styles.css")

  body.background-chicks
    .container
      .login-container(style="margin-top: 10px;")
        h2.text-center.py-3(style="color: rgb(34, 139, 34);") Welcome Back
        .card.login-card
          .card-header.login-header.text-center.py-3
            p
              i.fas.fa-user-circle.me-2
              | Sign in to your Young4ChickS account
          .card-body.p-4
            form#loginForm(ation='/login' method='POST')(Novalidate)
              // Email Input
              .mb-3
                label.form-label(for="email") Email address
                .input-group
                  span.input-group-text
                    i.fas.fa-envelope
                  input.form-control(name="email" id="email" placeholder="Enter your email" required)
                  .invalid-feedback
                    | Please provide a valid email address.

              // Password Input
              .mb-3
                label.form-label(for="password") Password
                .input-group
                  span.input-group-text
                    i.fas.fa-lock
                  input.form-control(name="password" id="password" placeholder="Enter your password" required)
                  button.btn.btn-outline-secondary(type="button" id="togglePassword")
                    i.fas.fa-eye
                  .invalid-feedback
                    | Please provide a password.

              // Remember Me & Forgot Password
              .d-flex.justify-content-between.mb-3
                .form-check
                  input.form-check-input(name="rememberMe" type="checkbox" id="rememberMe")
                  label.form-check-label(for="rememberMe")
                    | Remember me
                a.login-fg-pw(href="#") Forgot password?

              // Submit Button
              button.btn.btn-success.btn-login.w-100.mb-3(type="submit")
                i.fas.fa-sign-in-alt.me-2
                | Login

              // Social Login
              .text-center.mb-3
                p.text-muted Or login with
                button.btn.btn-outline-secondary.me-2(type="button")
                  i.fab.fa-google
                button.btn.btn-outline-secondary.me-2(type="button")
                  i.fab.fa-facebook-f
                button.btn.btn-outline-secondary(type="button")
                  i.fab.fa-twitter

              // Register Link
              .text-center
                p
                  | Don't have an account? 
                  a.login-fg-pw(href="/signup") Register here

    // Bootstrap JS Bundle with Popper
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script(src="/css/bootstrap/js/bootstrap.bundle.js")
    script(src="/js/include.js")
    // Custom JavaScript
    script(src="/scripts/loginScript.js")