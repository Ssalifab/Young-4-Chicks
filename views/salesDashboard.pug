extends layout 
block content 
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Young4ChickS Sales Dashboard
    // Bootstrap CSS
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='/css/bootstrap/css/bootstrap.css')
    // Font Awesome for icons
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/fontawesome-free-6.7.2-web/css/all.min.css')
    // Custom CSS
    link(rel='stylesheet' href='/css/styles.css')
  body.chicks 
    .container
      .row
        .col-lg-8.col-md-12.col-sm-12.dashboard-top-container.mt-2.d-flex.justify-content-left
          img.chicken-pic-dashboard(src='/img/chicken.jpg' alt='Logo')
          h3.mt-2 Young4ChickS
        .col-lg-4.col-md-12.col-sm-12.dashboard-top-container.mt-2.d-flex.justify-content-between
          p.mt-3.Welcome-h5Sales
            i
              b Welcome
          p.mt-3
            i.fa-regular.fa-user
            |  Namuli Ariella
          p.mt-3.Welcome-h5Sales
            b Sales Rep
          a(href='/logout')
            button.btn.btn-light.mt-2
              | Logout 
              i.fa-solid.fa-right-from-bracket
    .container
      .row
        .col-12.dashboard-button.mt-2.d-flex.justify-content-between
          h2.Welcome-h5Sales.mt-2 Sales Dashboard
          button.btn.btn-primary.dashboard-button.mt-1(data-bs-toggle='modal' data-bs-target='#newRequestModal')
            i.fa-solid.fa-phone
            |  New Request
    .container.dashboard-box.back_color
      .row.dashboard-box
        .col-lg-3.col-md-6.col-sm-12.dashboard-button.mt-3.d-flex.justify-content-between
          p Total Requests
          p 20
          i.fa-solid.fa-user-group.mt-1
        .col-lg-3.col-md-6.col-sm-12.dashboard-button.mt-3.d-flex.justify-content-between
          p.h5-dashboard-3 Pending Requests
          p.h5-dashboard-3 8
          i.fa-solid.fa-clock.mt-1
        .col-lg-3.col-md-6.col-sm-12.dashboard-button.mt-3.d-flex.justify-content-between
          p.h5-dashboard-4 Approved Requests
          p.h5-dashboard-4 15
          i.fa-solid.fa-circle-check.mt-1
        .col-lg-3.col-md-6.col-sm-12.dashboard-button.mt-3.d-flex.justify-content-between
          p.h5-dashboard-5 Revenue
          p.h5-dashboard-5 Ugx:
          p.h5-dashboard-5 1000000
          i.fa-solid.fa-dollar-sign.mt-1
    .container.dashboard-box
      .row.dashboard-box
        .col-lg-12.col-md-12.col-sm-12.dashboard-box
          .card
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-1.pending Pending Requests
              i.fa-regular.fa-hourglass-half.mb-1
            .card-body
              table#requestsTable.table.table-striped.table-h6-font.justify-content-between
                thead
                  tr
                    th Customer
                    th Type
                    th Breed
                    th Quantity
                    th Amount
                    th Farmer Type
                    th Status
                    th Date
                    th Actions
                tbody
          .card.mt-3
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-1.rejected Rejected Requests
              i.fa-solid.fa-ban.mb-1
            .card-body
              table#requestsTable.table.table-striped.table-h6-font.justify-content-between
                thead
                  tr
                    th Customer
                    th Type
                    th Breed
                    th Quantity
                    th Amount
                    th Farmer Type
                    th Status
                    th Date
                    th Actions
                tbody
          .card.mt-3
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-1.approved Approved Requests
              i.fa-solid.fa-thumbs-up.mb-1
            .card-body
              table#requestsTable.table.table-striped.table-h6-font.justify-content-between
                thead
                  tr
                    th Customer
                    th Type
                    th Breed
                    th Quantity
                    th Amount
                    th Farmer Type
                    th Status
                    th Date
                    th Actions
                tbody
          .card.mt-3
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-1.completed Completed Requests
              i.fa-solid.fa-flag-checkered.mb-1
            .card-body
              table#requestsTable.table.table-striped.table-h6-font.justify-content-between
                thead
                  tr
                    th Customer
                    th Type
                    th Breed
                    th Quantity
                    th Amount
                    th Farmer Type
                    th Status
                    th Date
                    th Actions
                tbody
    // New Request Modal
    #newRequestModal.modal.fade(tabindex='-1' aria-labelledby='exampleModalLabel' aria-hidden='true')
      .modal-dialog
        .modal-content
          .modal-header
            h1#newRequestModal.modal-title.fs-5(style='color: blue;') New Chick Request 
            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
          .modal-body
            form#newRequestForm(ation='/sales' method='POST') 
              .form-group
                label(for='farmerName') Farmer Name
                input#farmerName.form-control(name='farmerName' type='text')
              .form-group
                label(for='nin') National ID Number (NIN)
                input#nin.form-control(name='nin' type='text')
              .form-group
                label(for='type') Type
                select#type.form-control(name='type')
                  option(value='') --Select chick type--
                  option(value='layer') Layer
                  option(value='broiler') Broiler
              .form-group
                label(for='breed') Breed
                select#breed.form-control(name='breed')
                  option(value='') --Select breed--
                  option(value='local') Local
                  option(value='exotic') Exotic
              .form-group
                label(for='farmerType') Farmer Type
                select#farmerType.form-control(name='farmerType')
                  option(value='') --Select farmer type--
                  option(value='starter') Starter(Max 100 chicks)
                  option(value='returning') Returning (Max 500 chicks)
              .form-group
                label(for='quantity') Quantity
                input#quantity.form-control(name='quantity' type='number' placeholder='--Enter number of chicks--')
              .form-group
                label(for='dateUpdated') Date Updated
                input#dateUpdated.form-control(name='dateUpdated' type='date')
              a(href='/views/salesDashboard.html')
                button.btn.btn-light(type='button' style='width: 200px;')
                  i.fa-solid.fa-ban
                  |                 Cancel
              button.btn.btn-primary.me-2(type='submit')
                i.fa-solid.fa-plus
                |  Submit Request
              p#errorMsg.text-danger
  // Bootstrap JS Bundle with Popper
  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
  script(src='/css/bootstrap/js/bootstrap.bundle.js')
  script(src='/js/include.js')
  // Custom JavaScript
  //- script(src='/scripts/salesDashboard.js')
