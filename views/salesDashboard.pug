extends layout 
block content
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Young4ChickS Sales Dashboard
    // Bootstrap CSS
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='/css/bootstrap/css/bootstrap.css')
    // Font Awesome for icons
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet' href='/css/fontawesome-free-6.7.2-web/css/all.min.css')
    // Custom CSS
    link(rel='stylesheet' href='/css/styles.css')
  body.chicks 
    .container
      .row
        .col-lg-6.col-md-12.col-sm-12.dashboard-top-container.mt-2.d-flex.justify-content-left
          img.chicken-pic-dashboard(src='/img/chicken.jpg' alt='Logo')
          h3.mt-2 Young4ChickS
        .col-lg-6.col-md-12.col-sm-12.dashboard-top-container.mt-2.d-flex.justify-content-between
          p.mt-3.Welcome-h5Sales
            i
              b Welcome
          p.mt-3
            i.fa-regular.fa-user
            |  #{currentUser.name}
          p.mt-3.Welcome-h5Sales
            b #{currentUser.role}
          a(href='/logout')
            button.btn.btn-light.mt-2
              | Logout 
              i.fa-solid.fa-right-from-bracket
    .container
      .row
        .col-9.dashboard-button.mt-2.d-flex.justify-content-between
          h2.Welcome-h5Sales.mt-2 Sales Dashboard
        .col-3.dashboard-button.mt-2.d-flex.justify-content-between
          a.button.btn.btn-warning.dashboard-button.mt-1(href="/salesList" style="min-width: 120px;" class="d-flex justify-content-center align-items-center gap-2")
            i.fa-solid.fa-eye
            |  Sales   
          button.btn.btn-primary.dashboard-button.mt-1(data-bs-toggle='modal' data-bs-target='#newRequestModal')
            i.fa-solid.fa-phone
            |  New Request
    .container.dashboard-box.back_color
      .row.dashboard-box
        .col-lg-3.col-md-6.col-sm-12.dashboard-button.mt-3.d-flex.justify-content-between
          p Total Requests
          p #{totalRequests}
          i.fa-solid.fa-user-group.mt-1
        .col-lg-3.col-md-6.col-sm-12.dashboard-button.mt-3.d-flex.justify-content-between
          p.h5-dashboard-3 Pending Requests
          p.h5-dashboard-3  #{pendingRequests}
          i.fa-solid.fa-clock.mt-1
        .col-lg-3.col-md-6.col-sm-12.dashboard-button.mt-3.d-flex.justify-content-between
          p.h5-dashboard-4 Approved Requests
          p.h5-dashboard-4 #{approvedRequests}
          i.fa-solid.fa-circle-check.mt-1
        .col-lg-3.col-md-6.col-sm-12.dashboard-button.mt-3.d-flex.justify-content-between
          p.h5-dashboard-5 Revenue
          p.h5-dashboard-5 Ugx:
          p.h5-dashboard-5 #{chickSales}
          i.fa-solid.fa-dollar-sign.mt-1
    .container.dashboard-box
      .row.dashboard-box
        .col-lg-12.col-md-12.col-sm-12.dashboard-box
          .card
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-1.pending Pending Requests
              i.fa-regular.fa-hourglass-half.mb-1
            .card-body
              table#requestsTable.table.table-striped.table-h6-font.justify-content-between
                thead
                  tr
                    th Customer
                    th Type
                    th Breed
                    th Quantity
                    th Amount
                    th Farmer Type
                    th Status
                    th Date
                    th Actions
                tbody
                - requests = requests || [] 
                  if requests.length  
                    each item in requests
                      tr
                        td #{item.farmer.firstName} #{item.farmer.lastName}
                        td #{item.chickType || item.type}
                        td #{item.breed}
                        td #{item.quantity}
                        td #{item.farmerType}
                        td #{moment(item.dateUpdated).format('DD MM YYYY')} 
          .card.mt-3
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-1.rejected Rejected Requests
              i.fa-solid.fa-ban.mb-1
            .card-body
              table#requestsTable.table.table-striped.table-h6-font.justify-content-between
                thead
                  tr
                    th Customer
                    th Type
                    th Breed
                    th Quantity
                    th Amount
                    th Farmer Type
                    th Status
                    th Date
                    th Actions
                tbody
          .card.mt-3
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-1.approved Approved Requests
              i.fa-solid.fa-thumbs-up.mb-1
            .card-body
              table#requestsTable.table.table-striped.table-h6-font.justify-content-between
                thead
                  tr
                    th Customer
                    th Type
                    th Breed
                    th Quantity
                    th Amount
                    th Farmer Type
                    th Status
                    th Date
                    th Actions
                tbody
          .card.mt-3
            .card-header.d-flex.justify-content-between.align-items-center
              h5.mb-1.completed Completed Requests
              i.fa-solid.fa-flag-checkered.mb-1
            .card-body
              table#requestsTable.table.table-striped.table-h6-font.justify-content-between
                thead
                  tr
                    th Customer
                    th Type
                    th Breed
                    th Quantity
                    th Amount
                    th Farmer Type
                    th Status
                    th Date
                    th Actions
                tbody
    // New Request Modal
    #newRequestModal.modal.fade(tabindex='-1' aria-labelledby='exampleModalLabel' aria-hidden='true')
      .modal-dialog
        .modal-content
          .modal-header
            h1#newRequestModal.modal-title.fs-5(style='color: blue;') New Chick Request 
            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
          .modal-body
            form#newRequestForm(ation='/sales' method='POST') 
              input(type='hidden' name='dateUpdated' value=new Date().toISOString().split('T')[0])
              if messages && messages.success
                .alert.alert-success.alert-dismissible.fade.show
                  | #{messages.success}
                  button.close(type='button' data-dismiss='alert' aria-label='Close')
                    span(aria-hidden='true') &times;
              .form-group
                label(for='farmerSelect') Select Farmer
                - farmers = farmers || []
                select#farmerSelect.form-control(name='farmerId' required)
                  option(value='') -- Select Farmer --
                  each farmer in farmers
                    option(value=farmer._id data-nin=farmer.nin)= `${farmer.firstName} ${farmer.lastName} (NIN: ${farmer.nin})`
              .form-group
                label(for='nin') National ID Number (NIN)
                input#nin.form-control(name='nin' type='text' readonly)
              .form-group
                label(for='type') Type
                select#type.form-control(name='type')
                  option(value='') --Select chick type--
                  option(value='layer' selected=(submittedData && submittedData.type === 'layer')) Layer
                  option(value='broiler' selected=(submittedData && submittedData.type === 'broiler')) Broiler
              .form-group
                label(for='breed') Breed
                select#breed.form-control(name='breed')
                  option(value='') --Select breed--
                  option(value='local') Local
                  option(value='exotic') Exotic
              .form-group
                label(for='farmerType') Farmer Type
                .form-check
                  input.form-check-input#starter(type='radio' name='farmerType' value='starter'
                  checked = (isStarter ? 'checked': false))
                  label.form-check-label(for="starter") Starter Farmer (Max 100 Chicks)
                .form-check 
                   input.form-check-input#returning(type='radio' name='farmerType' value='returning'
                   checked = (isStarter ? false: 'checked'))
                   label.form-check-label(for="returning") Returning Farmer (Max 500 Chicks)
              .form-group
                label(for='quantity') Quantity
                input#quantity.form-control(name='quantity' type='number' placeholder='--Enter number of chicks--' min = '1' max = (isStarter ? 100 : 500))
                small.form-text-muted
                  | Maximum: #{isStarter ? '100' : '500'} Chicks 
              .form-group
                label(for='dateUpdated') Date Updated
                input#dateUpdated.form-control(name='dateUpdated' type='date')
              a(href='/sales')
                button.btn.btn-light(type='button' style='width: 200px;')
                  i.fa-solid.fa-ban
                  |                 Cancel
              button.btn.btn-primary.me-2(type='submit')
                i.fa-solid.fa-plus
                |  Submit Request
              p#errorMsg.text-danger
  script.
    document.getElementById('farmerSelect').addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];
      document.getElementById('nin').value = selectedOption.dataset.nin || '';
    });
  // Bootstrap JS Bundle with Popper
  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
  script(src='/css/bootstrap/js/bootstrap.bundle.js')
  script(src='/js/include.js')
  // Custom JavaScript
  //- script(src='/scripts/salesDashboard.js')
