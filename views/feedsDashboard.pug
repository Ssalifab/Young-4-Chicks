extends layout

block content

  .container-fluid.chicks
    .row 
      .col-md-3.ms-sm-auto.col-lg-2.px-md-4.mt-3
        a.btn.btn-success.btn-block(href="/stock") Back 

      main.col-md-9.ms-sm-auto.col-lg-10.px-md-4
        .d-flex.justify-content-between.flex-wrap.flex-md-nowrap.align-items-center.pt-3.pb-2.mb-3.border-bottom
          h1.h2 Feed Dashboard
          .btn-toolbar.mb-2.mb-md-0
            button.btn.btn-success.btn-secondary.me-2(type='button' data-bs-toggle='modal' data-bs-target='#addFeedsModal')
              i.fas.fa-plus.me-1
              | Add New Feed

        // Feed Data Table
        .table-responsive
          table.table.table-striped.table-hover
            thead
              tr
                th Feed Name
                th Type
                th Target Age
                th Brand
                th Stock (bags)
                th Price/kg
                th Expiry
                th Last Updated
                th Update 
                th Delete
            tbody
              if feeds.length
                each feed in feeds
                    tr
                        td #{feed.feedName}
                        td #{feed.feedType}
                        td #{feed.targetAge}
                        td #{feed.brand}
                        td #{feed.stock}
                        td #{feed.price}
                        td #{moment(feed.expiryDate).format('DD MM YYYY')}
                        td #{moment(feed.dateUpdated).format('DD MM YYYY')}
                        td
                          a.btn.btn-sm.btn-outline-primary.me-1(href=`/updateFeed/${feed._id}`) 
                            i.fas.fa-edit
                        td
                          form(method='POST' action='/deleteFeed')
                            input(type='hidden' name='id' value=feed._id)  
                            button.btn.btn-sm.btn-outline-danger(type='submit')  
                              i.fas.fa-trash
                                
  // Add Feeds Modal
  #addFeedsModal.modal.fade(tabindex='-1' aria-labelledby='addFeedsModalLabel' aria-hidden='true')
    .modal-dialog
      .modal-content
        .modal-header
          h1#addFeedsModalLabel.modal-title.fs-5 Add New Feeds
          button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
        .modal-body
          form#addFeedsForm(action='/feeds' method='POST')
            .form-group.mb-3
              label.form-label(for='feedName') Feed Name
              select#feedName.form-select(name='feedName' required)
                option(value='' selected disabled) --Select feed name--
                option(value='starter') Starter Feed
                option(value='grower') Grower Feed
                option(value='finisher') Finisher Feed

            .form-group.mb-3
              label.form-label(for='feedType') Feed Type
              select#feedType.form-select(name='feedType' required)
                option(value='' selected disabled) --Select feed type--
                option(value='mash') Mash
                option(value='crumble') Crumble
                option(value='pellet') Pellet

            .form-group.mb-3
              label.form-label(for='targetAge') Target Age
              select#targetAge.form-select(name='targetAge' required)
                option(value='' selected disabled) --Select target age--
                option(value='oneToSeven') Day 1-7
                option(value='eightToFourteen') Day 8-14
                option(value='fifteenToThirty') Day 15-30

            .form-group.mb-3
              label.form-label(for='brand') Brand / Supplier
              select#brand.form-select(name='brand' required)
                option(value='' selected disabled) --Select brand--
                option(value='ugaChick') UgaChick
                option(value='nuvita') Nuvita
                option(value='farmersChoice') Farmers Choice
                option(value='kukuFeed') Kuku feed

            .form-group.mb-3
              label.form-label(for='stock') Stock (100 kg bags)
              input#stock.form-control(name='stock' type='number' min='0' step='1' placeholder='Enter number of bags' required)

            .form-group.mb-3
              label.form-label(for='price') Price per kg
              input#price.form-control(name='price' type='number' min='0' step='0.01' placeholder='Enter price per kg' required)

            .form-group.mb-3
              label.form-label(for='expiryDate') Expiry Date
              input#expiryDate.form-control(name='expiryDate' type='date' required)

            .form-group.mb-3
              label.form-label(for='dateUpdated') Date Updated
              input#dateUpdated.form-control(name='dateUpdated' type='date' required)

            .d-flex.justify-content-between.mt-4
              button.btn.btn-light(type='button' data-bs-dismiss='modal' style='width: 200px;')
                i.fas.fa-ban.me-1
                | Cancel
              button.btn.btn-success(type='submit')
                i.fas.fa-plus.me-1
                | Add Stock

            p#errorMsg.text-danger.mt-2

  // Scripts
  script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
  script(src='https://kit.fontawesome.com/a076d05399.js' crossorigin='anonymous')
  //- script(src='/js/feeds.js')