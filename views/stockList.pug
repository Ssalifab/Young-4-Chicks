extends layout 
block content 
    head
        meta(charset='UTF-8')
        meta(name='viewport' content='width=device-width, initial-scale=1.0')
        title Stock List
    body.chicks
        .container
            .row
                .col-lg-2.col-md-4.col-sm-6.dashboard-box
                    a.btn.btn-success.btn-block(href="/stock") Back
                .col-lg-12.col-md-12.col-sm-12.dashboard-box.back_color
                    .card
                        .card-header.d-flex.justify-content-between.align-items-center
                            h5.mb-1
                                | Stock List (Exotic Breed)  
                                i.fa.fa-circle-user
                            .card-body
                                table.table.table-striped.table-h6-font.justify-content-between
                                    thead
                                        tr
                                            th(scope='col') Chick Type
                                            th(scope='col') Breed
                                            th(scope='col') Quantity
                                            th(scope='col') Age
                                            th(scope='col') Date Received
                                            th(scope='col') Update
                                            th(scope='col') Delete
                                    tbody
                                        if stocks.length 
                                            each stock in stocks
                                                if stock.breed=="exotic"
                                                    tr 
                                                        td #{stock.chickType}
                                                        td #{stock.breed}
                                                        td #{stock.quantity}
                                                        td #{stock.age}
                                                        td #{moment(stock.dateUpdated).format("DD-MM-YYYY")}
                                                        td 
                                                            a.btn.btn-primary.btn-block(href="/updateStock/"+stock._id) Update
                                                        td
                                                            form(method='POST' action='/deleteStock')
                                                                input(type='hidden' name='id' value=stock._id)  
                                                                button.btn.btn-danger.btn-block(type='submit') Delete  

                .col-lg-12.col-md-12.col-sm-12.dashboard-box
                    .card
                        .card-header.d-flex.justify-content-between.align-items-center
                            h5.mb-1
                                | Stock List (Local Breed)  
                                i.fa.fa-circle-user
                            .card-body
                                table.table.table-striped.table-h6-font.justify-content-between
                                    thead
                                        tr
                                            th(scope='col') Chick Type
                                            th(scope='col') Breed
                                            th(scope='col') Quantity
                                            th(scope='col') Age
                                            th(scope='col') Date Received
                                            th(scope='col') Update
                                            th(scope='col') Delete
                                    tbody
                                        if stocks.length 
                                            each stock in stocks
                                                if stock.breed=="local"
                                                    tr 
                                                        td #{stock.chickType}
                                                        td #{stock.breed}
                                                        td #{stock.quantity}
                                                        td #{stock.age}
                                                        td #{moment(stock.dateUpdated).format("DD-MM-YYYY")}
                                                        td 
                                                            a.btn.btn-primary.btn-block(href="/updateStock/"+stock._id) Update
                                                        td
                                                            form(method='POST' action='/deleteStock')
                                                                input(type='hidden' name='id' value=stock._id)  
                                                                button.btn.btn-danger.btn-block(type='submit') Delete  
            
